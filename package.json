{
  "name": "camNC-apps",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test -- run",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-format": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "playwright": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "vite-plugin-node-polyfills": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@firebase-ui/react@0.0.1": "https://github.com/firebase/firebaseui-web/raw/refs/heads/v7-alpha/releases/firebase-ui-react-0.0.1.tgz",
      "@firebase-ui/core@0.0.1": "https://github.com/firebase/firebaseui-web/raw/refs/heads/v7-alpha/releases/firebase-ui-core-0.0.1.tgz",
      "@firebase-ui/styles@0.0.1": "https://github.com/firebase/firebaseui-web/raw/refs/heads/v7-alpha/releases/firebase-ui-styles-0.0.1.tgz",
      "@firebase-ui/translations@0.0.1": "https://github.com/firebase/firebaseui-web/raw/refs/heads/v7-alpha/releases/firebase-ui-translations-0.0.1.tgz"
    }
  }
}