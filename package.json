{
  "name": "camNC-apps",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "node scripts/test-lock.mjs \"node scripts/turbo-shared-cache.mjs run test -- run && pnpm run test:performance\"",
    "test:fast": "node scripts/turbo-shared-cache.mjs run test --filter=!@wbcnc/camNC -- run && node scripts/turbo-shared-cache.mjs run test:fast",
    "test:ci": "node --test scripts/ci-config.test.mjs scripts/test-lock.test.mjs",
    "test:performance": "pnpm --filter @wbcnc/cam test:performance && pnpm --filter @wbcnc/camNC test:performance",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-format": "prettier --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "simple-git-hooks",
    "sim": "pnpm --filter @wbcnc/fluidnc sim --"
  },
  "devDependencies": {
    "nano-staged": "^1.0.2",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "simple-git-hooks": "^2.13.1",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-node-polyfills": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "pnpm": {},
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged"
  },
  "nano-staged": {
    "*.{ts,tsx,md}": "prettier --write"
  }
}
