{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "VITE_CLERK_PUBLISHABLE_KEY"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {},
    "smoke:setup": {
      "cache": false,
      "env": ["CAMNC_SMOKE_URL", "CAMNC_SMOKE_HEADED", "CAMNC_SMOKE_OUTPUT"]
    },
    "lint": {},
    "check-types": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "VITE_CLERK_PUBLISHABLE_KEY"
      ]
    }
  }
}
