{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "DATABASE_URL",
        "CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "VITE_CLERK_PUBLISHABLE_KEY"
      ],
      "outputs": [
        ".nitro/**",
        ".tanstack/start/**",
        ".vercel/output/**",
        "dist/**"
      ]
    },
    "test": {},
    "lint": {},
    "check-types": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "VITE_CLERK_PUBLISHABLE_KEY"
      ]
    }
  }
}
