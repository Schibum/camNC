{
  "rules": {
    /* Top level: everything closed by default */
    ".read":  false,
    ".write": false,

    /* ─────────────────────────────────────────────── */
    "__signaller__": {
      /* still closed so nobody can list all rooms */
      ".read":  false,
      ".write": false,

      /* Any *known* $roomId becomes readable/writable */
      "$roomId": {
        ".read":  true,        // subscribe once you know the roomId
        ".write": false,       // default-deny; open only the peer subtree

        /* Each peer gets its own subtree */
        "$peerId": {
          /* full read/write access for the client ***
             (needed for remove() followed by set() in join())        */
          ".read":  true,
          ".write": true,
            
          "_": {
            ".validate":
              "newData.hasChildren(['peerId','role','ts']) && newData.child('peerId').val() === $peerId"
          },

          /* Optional: keep every individual message ≤ 4 KB */
          "$fromPeerId": {
            "$msgId": {
              ".validate":
                "newData.isString() && newData.val().length <= 4096"
            }
          }
        }
      }
    }
  }
}
