{
  "name": "@wbcnc/camNC",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.worker.config.ts && vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "smoke:setup": "node e2e/setup-smoke.mjs",
    "check-types": "tsc --noEmit && tsc --noEmit -p worker",
    "db:generate": "drizzle-kit generate",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:preview": "wrangler d1 migrations apply DB --remote --env preview && wrangler versions upload --env preview",
    "dev:api": "mkdir -p dist && wrangler d1 migrations apply DB --local && wrangler dev --port 8787"
  },
