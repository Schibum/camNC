  {
    "id": "sketch/mirror/circle-linked",
    "title": "Mirror about a construction line makes a linked copy",
    "evidence": "Codex native check 2026-11-06: editing the source diameter changed both",
    "steps": [
      "line 100,10 100,110",
      "click 100,60",
      "key q",
      "key Space",
      "circle 60,60 20",
      "click 80,60",
      "button Mirror",
      "click 100,60",
      "key Escape",
      "key Escape",
      {
        "expect": {
          "entitiesInclude": [
            {
              "type": "circle",
              "c": [
                60,
                60
              ],
              "r": 20
            },
            {
              "type": "circle",
              "c": [
                140,
                60
              ],
              "r": 20
            }
          ]
        }
      },
      "key d",
      "click 80,60",
      "click 40,100",
      "type 25",
      "key Enter",
      {
        "expect": {
          "entitiesInclude": [
            {
              "type": "circle",
              "c": [
                60,
                60
              ],
              "r": 12.5
            },
            {
              "type": "circle",
              "c": [
                140,
                60
              ],
              "r": 12.5
            }
          ]
        }
      }
    ]
