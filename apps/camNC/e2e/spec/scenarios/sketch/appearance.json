[
  {
    "id": "sketch/appearance/preview-line-weight",
    "title": "Line, rectangle and circle previews draw at the committed weight",
    "evidence": "manu 2026-11-06; reference-live via Codex transcript",
    "steps": [
      "line 20,100 80,100",
      "key l",
      "click 20,40",
      "hover 80,60",
      {
        "expect": {
          "strokePx": [
            0.5,
            3
          ],
          "previewCount": 1
        }
      },
      "key Escape",
      "key Escape",
      "key g",
      "click 120,40",
      "hover 170,70",
      {
        "expect": {
          "strokePx": [
            0.5,
            3
          ]
        }
      },
      "key Escape",
      "key Escape",
      "key c",
      "click 200,60",
      "hover 220,60",
      {
        "expect": {
          "strokePx": [
            0.5,
            3
          ]
        }
      }
    ]
  },
