[
  {
    "id": "sketch/dimension/line-length",
    "title": "D, line, place, type: sets the length and D stays armed",
    "evidence": "reference-docs Sketch/dimension.htm",
    "steps": [
      "line 20,40 120,40",
      "key d",
      "click 70,40",
      "click 70,70",
      {
        "expect": {
          "focus": "input"
        }
      },
      "type 80",
      "key Enter",
      {
        "expect": {
          "dimensions": [
            {
              "value": 80
            }
          ],
          "tool": "dimension",
          "focus": "canvas"
        }
      }
    ]
  },
