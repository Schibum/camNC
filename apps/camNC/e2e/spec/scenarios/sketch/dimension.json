  {
    "id": "sketch/dimension/select-then-edit",
    "title": "One click selects a dimension, a double click edits it, Delete removes it",
    "evidence": "reference-docs Sketch/dimension.htm; reference-live via Codex transcript",
    "steps": [
      "line 20,40 120,40",
      "key d",
      "click 70,40",
      "click 70,70",
      "type 90",
      "key Enter",
      "key Escape",
      "key Escape",
      "selectdim",
      {
        "expect": {
          "focus": "canvas",
          "status": "selected"
        }
      },
      "editdim",
      {
        "expect": {
          "focus": "input"
        }
      },
      "type 70",
      "key Enter",
      {
        "expect": {
          "dimensions": [
            {
              "value": 70
            }
          ]
        }
      },
      "selectdim",
      "key Delete",
      {
        "expect": {
          "dimensions": [],
          "entityCount": 1
        }
      },
      "key Control+z",
      {
        "expect": {
          "dimensions": [
            {
              "value": 70
            }
          ]
        }
      }
    ]
  },
