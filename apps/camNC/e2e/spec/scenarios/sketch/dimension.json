  {
    "id": "sketch/dimension/point-point-by-cursor",
    "title": "Two points give horizontal or vertical distance depending on where you place it",
    "evidence": "reference-report native-dimensions; reference-docs Sketch/dimension.htm",
    "steps": [
      "line 40,20 100,60",
      "key d",
      "click 40,20",
      "click 100,60",
      "click 70,100",
      "key Enter",
      {
        "expect": {
          "dimensions": [
            {
              "kind": "horizontal",
              "value": 60,
              "tol": 1.5
            }
          ]
        }
      },
      "click 40,20",
      "click 100,60",
      "click 150,40",
      "key Enter",
      {
        "expect": {
          "dimensionsInclude": [
            {
              "kind": "horizontal",
              "value": 60,
              "tol": 1.5
            },
            {
              "kind": "vertical",
              "value": 40,
              "tol": 1.5
            }
          ]
        }
      }
    ]
  },
