      "click 40,40",
      "click 40,40",
      {
        "expect": {
          "entityCount": 0,
          "status": "greater than zero"
        }
      },
      "key Escape",
      "key Escape",
      "key c",
      "click 40,40",
      "click 40,40",
      {
        "expect": {
          "entityCount": 0,
          "status": "greater than zero"
        }
      },
      "key Escape",
      "key Escape",
      "key a",
      "click 20,40",
      "click 80,40",
      "click 50,40",
      {
        "expect": {
          "entityCount": 0,
          "status": "straight line"
        }
      }
    ]
  },
