[
  {
    "id": "sketch/draw/drag-line",
    "title": "Press, drag and release draws one line and the tool stays armed",
    "evidence": "reference-live 2026-11-06; reference-docs Sketch/line.htm",
    "steps": [
      "key l",
      "drag 20,40 80,40",
      {
        "expect": {
          "entities": [
            {
              "type": "line",
              "a": [
                20,
                40
              ],
              "b": [
                80,
                40
              ]
            }
          ],
          "tool": "line",
          "focus": "canvas"
        }
      },
      "drag 20,70 80,70",
      {
        "expect": {
          "entityCount": 2
        }
      }
    ]
  },
