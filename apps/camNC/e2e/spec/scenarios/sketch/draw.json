  {
    "id": "sketch/draw/tangent-continuation",
    "title": "Shift+A while drawing a line makes a tangent arc and returns to Line",
    "evidence": "reference-docs Sketch/line.htm",
    "steps": [
      "key l",
      "click 20,20",
      "click 60,20",
      "key Shift+a",
      "click 60,60",
      {
        "expect": {
          "tool": "line",
          "constraintsAtLeast": {
            "tangent": 1
          },
          "entitiesInclude": [
            {
              "type": "arc",
              "a": [
                60,
                20
              ],
              "b": [
                60,
                60
              ],
              "r": 20
            }
          ]
        }
      },
      "click 20,60",
      "key Escape",
      "key Escape",
      {
        "expect": {
          "entitiesInclude": [
            {
              "type": "line",
              "a": [
                60,
                60
              ],
              "b": [
                20,
                60
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "id": "sketch/draw/hover-inference-persists",
    "title": "Snapping a line's end to a hovered endpoint's alignment saves a relation",
    "evidence": "manu 2026-11-06; reference-docs Sketch/automatic_inferencing.htm",
    "steps": [
      "line 40,20 40,80",
      "key l",
      "click 80,50",
      "hover 40,80",
      "hover 90,80",
      "click 90,80",
      "key Escape",
      "key Escape",
      {
        "expect": {
          "constraintsAtLeast": {
            "horizontalPoints": 1
          },
          "entityCount": 2
        }
      }
    ]
  },
  {
    "id": "sketch/draw/shift-suppresses-inference",
    "title": "Holding Shift while drawing keeps a nearly horizontal line free",
    "evidence": "reference-docs keyboard shortcuts",
    "steps": [
      "line 20,40 120,41",
      {
        "expect": {
          "constraintsAtLeast": {
            "horizontal": 1
          }
        }
      },
      "key Control+z",
      "key l",
      "hold Shift",
      "click 20,60",
      "click 120,62",
      "release Shift",
      "key Escape",
      "key Escape",
      {
        "expect": {
          "constraintsNone": [
            "horizontal"
          ],
          "entitiesInclude": [
            {
              "type": "line",
              "a": [
                20,
                60
              ],
              "b": [
                120,
                62
              ],
              "tol": 0.8
            }
          ]
        }
      }
    ]
  },
  {
    "id": "sketch/draw/degenerate-ignored",
