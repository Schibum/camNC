[
  {
    "id": "sketch/spline/handle-segment-horizontal",
    "title": "H on a spline's tangent segment makes it horizontal",
    "evidence": "reference-report native-spline-constraints",
    "steps": [
      "tool Spline",
      "click 40,30",
      "click 80,70",
      "click 120,30",
      "key Escape",
      "key Escape",
      "handle start segment",
      "key h",
      {
        "expect": {
          "constraintsAtLeast": {
            "horizontal": 1
          },
          "status": "degrees? of freedom",
          "entityCount": 1
        }
      }
    ]
  },
  {
    "id": "sketch/spline/handle-segment-vertical",
    "title": "V on a spline's tangent segment makes it vertical",
    "evidence": "reference-report native-spline-constraints",
