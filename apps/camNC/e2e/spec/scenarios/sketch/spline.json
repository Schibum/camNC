  {
    "id": "sketch/spline/handle-point-parallel-rejected",
    "title": "A handle point plus a line is rejected for parallel, without becoming its segment",
    "evidence": "reference-report native-spline-constraints",
    "steps": [
      "line 40,100 120,120",
      "tool Spline",
      "click 40,30",
      "click 80,70",
      "click 120,30",
      "key Escape",
      "key Escape",
      "handle start point",
      "shiftclick 80,110",
      "key b",
      {
        "expect": {
          "constraintsNone": [
            "parallel"
          ]
        }
      }
    ]
  },
  {
    "id": "sketch/spline/handle-segment-length",
    "title": "D on a tangent segment measures its length and is editable",
    "evidence": "reference-report native-spline-constraints: segment Length 50 mm",
    "steps": [
      "tool Spline",
      "click 40,30",
      "click 80,70",
      "click 120,30",
      "key Escape",
      "key Escape",
      "key d",
      "handle start segment",
      "click 10,80",
      "type 30",
      "key Enter",
      {
        "expect": {
          "dimensions": [
            {
              "value": 30
            }
          ],
          "status": "degrees? of freedom"
        }
      }
    ]
  },
  {
    "id": "sketch/spline/handle-delete-protected",
    "title": "Delete doesn't remove a spline's own tangent segment",
    "evidence": "reference-report native-spline-constraints: protected deletion",
    "steps": [
      "tool Spline",
      "click 40,30",
      "click 80,70",
      "click 120,30",
      "key Escape",
      "key Escape",
      "handle start segment",
      "key Delete",
      {
        "expect": {
          "entityCount": 1,
          "entitiesInclude": [
            {
              "type": "spline",
              "a": [
                40,
                30
              ],
              "b": [
                120,
                30
              ]
            }
          ]
        }
      }
    ]
  }
]
