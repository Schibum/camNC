      "key Escape",
      "handle end segment",
      "key v",
      {
        "expect": {
          "constraintsAtLeast": {
            "vertical": 1
          },
          "status": "degrees? of freedom"
        }
      }
    ]
  },
  {
    "id": "sketch/spline/handle-segment-parallel-line",
    "title": "A tangent segment and an ordinary line can be parallel",
    "evidence": "reference-report native-spline-constraints",
    "steps": [
      "line 40,100 120,120",
      "tool Spline",
      "click 40,30",
      "click 80,70",
      "click 120,30",
      "key Escape",
      "key Escape",
      "handle start segment",
      "shiftclick 80,110",
      "key b",
      {
        "expect": {
          "constraintsAtLeast": {
            "parallel": 1
          },
          "status": "degrees? of freedom"
        }
      }
    ]
  },
  {
    "id": "sketch/spline/handle-segment-tangent-circle",
