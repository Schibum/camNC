  {
    "id": "sketch/constraint/conflict-recoverable",
    "title": "A contradictory constraint is reported and Undo restores a solved sketch",
    "evidence": "reference-live via Codex transcript 2026-11-06",
    "steps": [
      "line 20,20 120,60",
      "click 70,40",
      "key h",
      "click 70,20",
      "key v",
      {
        "expect": {
          "status": "attention|conflict|could not"
        }
      },
      "key Control+z",
      {
        "expect": {
          "status": "degrees? of freedom",
          "constraintsAtLeast": {
            "horizontal": 1
          }
        }
      }
    ]
  },
  {
    "id": "sketch/select/window-encloses",
    "title": "A left-to-right box selects only what is fully inside",
    "evidence": "reference-report via Codex transcript 2026-11-06",
    "steps": [
      "rect 40,30 100,90",
      "circle 180,60 15",
      "drag 20,100 120,20",
      "key Delete",
      {
        "expect": {
          "entities": [
            {
              "type": "circle",
              "c": [
                180,
                60
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "id": "sketch/select/crossing-touches",
