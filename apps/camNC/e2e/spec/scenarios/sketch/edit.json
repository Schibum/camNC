      "line 20,20 120,70",
      "drag 120,70 160,100",
      {
        "expect": {
          "entities": [
            {
              "type": "line",
              "a": [
                20,
                20
              ],
              "b": [
                160,
                100
              ]
            }
          ]
        }
      },
      "key Control+z",
      {
        "expect": {
          "entities": [
            {
              "type": "line",
              "a": [
                20,
                20
              ],
              "b": [
                120,
                70
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "id": "sketch/modify/drag-joins-endpoints",
    "title": "Dragging one endpoint onto another joins them for later drags",
    "evidence": "manu 2026-11-06; reference-live via Codex transcript",
    "steps": [
      "line 20,20 80,50",
      "line 120,60 180,100",
      "drag 80,50 120,60",
      {
        "expect": {
          "constraintsAtLeast": {
            "coincident": 1
          }
        }
      },
      "drag 120,60 120,110",
      {
        "expect": {
          "entitiesInclude": [
            {
              "type": "line",
              "a": [
                20,
                20
              ],
              "b": [
                120,
                110
              ]
            },
            {
              "type": "line",
              "a": [
                120,
                110
              ],
              "b": [
                180,
                100
              ]
            }
          ]
        }
      }
    ]
  },
  {
    "id": "sketch/modify/dimension-limits-drag",
