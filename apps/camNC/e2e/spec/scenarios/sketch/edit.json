  {
    "id": "sketch/history/undo-redo-keys",
    "title": "Undo and both redo chords work",
    "evidence": "reference-live 2026-11-06, Ctrl+Y redo",
    "steps": [
      "line 20,20 120,20",
      "key Control+z",
      {
        "expect": {
          "entityCount": 0,
          "canRedo": true
        }
      },
      "key Control+Shift+z",
      {
        "expect": {
          "entityCount": 1
        }
      },
      "key Control+z",
      "key Control+y",
      {
        "expect": {
          "entityCount": 1
        }
      },
      "key Meta+z",
      "key Meta+y",
      {
        "expect": {
          "entityCount": 1
        }
      }
    ]
  },
  {
    "id": "sketch/history/drag-is-one-undo",
