[
  {
    "id": "sketch/constraint/equal-preselected",
    "title": "Select two lines, press E: they become equal",
    "evidence": "reference-docs keyboard shortcuts",
    "steps": [
      "line 20,20 120,20",
      "line 20,60 80,60",
      "click 70,20",
      "shiftclick 50,60",
      "key e",
      {
        "expect": {
          "constraintsAtLeast": {
            "equal": 1
          }
        }
      }
    ]
  },
