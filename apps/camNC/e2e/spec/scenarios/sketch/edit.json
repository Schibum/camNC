  },
  {
    "id": "sketch/select/shift-adds-space-clears",
    "title": "Shift adds to the selection and Space clears it",
    "evidence": "reference-docs keyboard shortcuts",
    "steps": [
      "line 20,20 120,20",
      "line 20,60 120,60",
      "line 20,100 120,100",
      "click 70,20",
      "shiftclick 70,60",
      "key Space",
      "key Delete",
      {
        "expect": {
          "entityCount": 3
        }
      },
      "click 70,20",
      "shiftclick 70,60",
      "key Delete",
      {
        "expect": {
          "entities": [
            {
              "type": "line",
              "a": [
                20,
                100
              ],
              "b": [
                120,
                100
              ]
            }
          ]
        }
      }
    ]
  },
