{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camnc",
  // plainoss account
  "account_id": "60d502e306ecf0bdad0bb3719d83b30c",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is served as static files without invoking the Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camnc",
      // Created with `wrangler d1 create camnc`.
      "database_id": "7f88bf20-b857-4540-9804-0ee5db7e99b9",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Secrets (wrangler secret put): CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY, CLERK_JWT_KEY (optional).
  // Worker Previews (`wrangler preview`, one per PR). Previews don't inherit the bindings above, so
  // everything they need is repeated here and points at preview-only resources: Clerk development
  // keys (`wrangler preview base-config secret put`) and the camnc-preview database, never production data.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "camnc-preview",
        // Created with `wrangler d1 create camnc-preview`. Keep in sync with wrangler.preview-migrations.jsonc.
        "database_id": "fcf09ced-d315-410d-bd63-f20383984482",
        "migrations_dir": "migrations"
      }
    ]
  }
}
