{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camnc",
  // plainoss account
  "account_id": "60d502e306ecf0bdad0bb3719d83b30c",
  "main": "worker/index.ts",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is served as static files without invoking the Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "camnc",
      // Created with `wrangler d1 create camnc`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Secrets (wrangler secret put): CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY, CLERK_JWT_KEY
  "env": {
    // PR previews: `wrangler versions upload --env preview --preview-alias pr-<n>`.
    // Uses Clerk development keys and its own database, never production data.
    "preview": {
      "name": "camnc-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "camnc-preview",
          // Created with `wrangler d1 create camnc-preview`.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
