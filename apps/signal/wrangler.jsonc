{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "camnc-signal",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "SignalRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }],
  "ratelimits": [
    {
      "name": "CONNECT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "vars": {
    // Old *.vercel.app hosts stay while the apps move to Workers. Keep in sync with the app hostnames.
    "ALLOWED_ORIGINS": "https://run.camnc.app,https://camnc.app,https://*.camnc.app,https://camnc*.vercel.app,https://fluidnc-integration*.vercel.app,https://*.workers.dev,http://localhost:*,http://127.0.0.1:*",
  },
  // Deployed to the plainoss Cloudflare account. The workers.dev host stays reachable as a fallback.
  "routes": [{ "pattern": "signal.camnc.app", "custom_domain": true }],
  "workers_dev": true,
}
