---
const githubUrl = "https://github.com/Schibum/camNC";
---

<footer class="border-t border-default bg-offset py-10">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-6 text-center text-sm text-offset">
    <p>
      camNC is free and open-source. Contributions and feedback are welcome on GitHub.
    </p>
    <a
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center rounded-full border border-default px-4 py-2 font-medium text-default transition hover:bg-default/10 focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2 focus:ring-offset-transparent"
    >
      View the repository
    </a>
  </div>
</footer>
