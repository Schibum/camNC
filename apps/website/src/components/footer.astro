---
const githubUrl = "https://github.com/Schibum/camNC";
---

<footer class="border-t border-default bg-offset py-10">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-6 text-center text-sm text-offset">
    <div class="flex items-center gap-2">
      <img src="/favicon.svg" alt="CamNC logo" class="size-6" />
      <span class="font-bold tracking-tight text-default">Cam<span class="text-amber-500">NC</span></span>
    </div>
    <p>
      camNC is free and open-source. Contributions and feedback are <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="text-default underline hover:text-default/80">welcome on GitHub.</a>
    </p>

  </div>
</footer>
