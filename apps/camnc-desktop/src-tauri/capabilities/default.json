{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the camNC frontend may do: the app's own page only (served on 127.0.0.1:41987 in builds, the vite dev server in development).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-go2rtc-stream",
    "websocket:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://10.*:*"
        },
        {
          "url": "http://172.*:*"
        },
        {
          "url": "http://192.168.*:*"
        },
        {
          "url": "http://169.254.*:*"
        },
        {
          "url": "http://*.local:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://localhost:*"
        }
      ]
    }
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:41987/*",
      "http://localhost:5173/*"
    ]
  }
}
