{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the bundled camNC frontend may do. No remote origin gets these.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "websocket:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://10.*:*" },
        { "url": "http://172.*:*" },
        { "url": "http://192.168.*:*" },
        { "url": "http://169.254.*:*" },
        { "url": "http://*.local:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://localhost:*" }
      ]
    }
  ]
}
